.DS_Store
.pio/
.claude/worktrees/
.claude/settings.local.json
hardware/.mcp-backups/
hardware/*-backups/
hardware/fp-info-cache
hardware/*.kicad_prl
hardware/~*.lck
*.lck

# Datasheets are fetched for reading, not redistributed: hardware/datasheets/README.md lists sources and revisions
hardware/datasheets/*
!hardware/datasheets/README.md
__pycache__/

# Routing by-products: the router's log and session, and the boards saved between steps
hardware/route/*
!hardware/route/run.sh
!hardware/route/rev-b_input.kicad_pcb
